animations {
    workspace-switch {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }

    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=950 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=0.90 stiffness=850 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }

    window-open {
        duration-ms 320
        curve "cubic-bezier" 0.16 1 0.3 1

        custom-shader r"
            float hash(vec2 p) {
                vec3 p3 = fract(vec3(p.xyx) * 0.1031);
                p3 += dot(p3, p3.yzx + 33.33);
                return fract((p3.x + p3.y) * p3.z);
            }

            float noise(vec2 p) {
                vec2 i = floor(p);
                vec2 f = fract(p);
                f = f * f * (3.0 - 2.0 * f);

                float a = hash(i);
                float b = hash(i + vec2(1.0, 0.0));
                float c = hash(i + vec2(0.0, 1.0));
                float d = hash(i + vec2(1.0, 1.0));

                return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
            }

            float fbm(vec2 p) {
                float v = 0.0;
                float amp = 0.5;

                for (int i = 0; i < 3; i++) {
                    v += amp * noise(p);
                    p *= 2.0;
                    amp *= 0.5;
                }

                return v;
            }

            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                vec2 uv = coords_geo.xy;
                float seed = niri_random_seed * 37.0;

                float n1 = fbm(uv * 3.0 + seed);
                float n2 = fbm(uv * 3.0 + vec2(4.7, 1.9) - seed);

                float dist = length((uv - 0.5) * vec2(1.0, 0.72));
                float field = dist * 1.75 + (1.0 - 0.5 * (n1 + n2)) * 0.58;

                float front = mix(0.10, 1.72, p);
                float reveal = 1.0 - smoothstep(front - 0.33, front + 0.33, field);

                float wob = 0.045 * (1.0 - p) * (1.0 - p);
                vec2 warped = uv + (vec2(n1, n2) - 0.5) * wob;
                vec4 color = texture2D(niri_tex, (niri_geo_to_tex * vec3(warped, 1.0)).st);

                return color * reveal;
            }
        "
    }

    window-close {
        duration-ms 260
        curve "cubic-bezier" 0.30 0.85 0.25 1

        custom-shader r"
            float hash(vec2 p) {
                vec3 p3 = fract(vec3(p.xyx) * 0.1031);
                p3 += dot(p3, p3.yzx + 33.33);
                return fract((p3.x + p3.y) * p3.z);
            }

            float noise(vec2 p) {
                vec2 i = floor(p);
                vec2 f = fract(p);
                f = f * f * (3.0 - 2.0 * f);

                float a = hash(i);
                float b = hash(i + vec2(1.0, 0.0));
                float c = hash(i + vec2(0.0, 1.0));
                float d = hash(i + vec2(1.0, 1.0));

                return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
            }

            float fbm(vec2 p) {
                float v = 0.0;
                float amp = 0.5;

                for (int i = 0; i < 3; i++) {
                    v += amp * noise(p);
                    p *= 2.0;
                    amp *= 0.5;
                }

                return v;
            }

            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                vec2 uv = coords_geo.xy;
                float seed = niri_random_seed * 37.0;

                float n1 = fbm(uv * 3.0 + seed);
                float n2 = fbm(uv * 3.0 + vec2(4.7, 1.9) - seed);

                float dist = length((uv - 0.5) * vec2(1.0, 0.72));
                float field = dist * 1.75 + (1.0 - 0.5 * (n1 + n2)) * 0.58;

                float front = mix(1.72, 0.10, p);
                float remain = 1.0 - smoothstep(front - 0.33, front + 0.33, field);
                float tail = 1.0 - smoothstep(0.82, 1.0, p);

                float wob = 0.050 * p * p;
                vec2 warped = uv + (vec2(n1, n2) - 0.5) * wob;
                vec4 color = texture2D(niri_tex, (niri_geo_to_tex * vec3(warped, 1.0)).st);

                return color * remain * tail;
            }
        "
    }

    config-notification-open-close {
        spring damping-ratio=0.75 stiffness=1100 epsilon=0.001
    }

    screenshot-ui-open {
        duration-ms 180
        curve "ease-out-quad"
    }

    overview-open-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    exit-confirmation-open-close {
        spring damping-ratio=0.80 stiffness=550 epsilon=0.005
    }

    recent-windows-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.001
    }
}
