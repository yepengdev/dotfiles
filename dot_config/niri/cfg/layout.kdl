layout {
    gaps 10
    center-focused-column "on-overflow"
    background-color "transparent"

    default-column-width { proportion 0.5; }

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    preset-window-heights {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    border {
        off
    }

    focus-ring {
        on
        width 2
        active-gradient from="#89b4fa" to="#cba6f7" angle=35 relative-to="workspace-view"
        inactive-color "#45475a"
        urgent-color "#f38ba8"
    }

    insert-hint {
        gradient from="#89b4fa66" to="#cba6f766" angle=45
    }

    shadow {
        on
        softness 36
        spread 2
        offset x=0 y=6
        color "#00000045"
        inactive-color "#0000001a"
    }

    tab-indicator {
        hide-when-single-tab
        place-within-column

        gap 8
        width 4
        length total-proportion=0.75
        position "left"
        gaps-between-tabs 6
        corner-radius 4

        active-gradient from="#89b4fa" to="#cba6f7" angle=45 relative-to="workspace-view"
        inactive-color "#45475a"
        urgent-color "#f38ba8"
    }
}
