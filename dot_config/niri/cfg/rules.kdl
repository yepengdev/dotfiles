window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
    background-effect {
        xray true
        blur true
        noise 0.03
        saturation 1.15
    }
}

layer-rule {
    match namespace="^noctalia-wallpaper*"
    place-within-backdrop true
}

window-rule {
    match is-active=false
    opacity 0.92
}

window-rule {
    match app-id="^org.gnome.Loupe"
    open-floating true
}

window-rule {
    match app-id="emacs"
    open-maximized true
    background-effect {
        xray true
        blur true
        noise 0.02
        saturation 1.05
    }
}

window-rule {
    match app-id="foot"
    background-effect {
        xray true
        blur true
        noise 0.02
        saturation 1.05
    }
}

window-rule {
    match app-id="^org.pwmt.zathura$"
    open-maximized true
    opacity 0.95
}

window-rule {
    match app-id="^nautilus$"
    match app-id="^org.gnome.Nautilus$"
    match app-id="^thunar$"
    popups {
        geometry-corner-radius 12
        background-effect {
            blur true
        }
    }
}

window-rule {
    match app-id="^Alacritty$"
    open-maximized true
    background-effect {
        blur true
    }
}

layer-rule {
    match namespace="^launcher$"
    background-effect {
        blur true
    }
}

window-rule {
    match app-id="^brave-origin-nightly$"
    open-maximized true
    opacity 0.9
    background-effect {
        blur true
        xray true
    }
}

window-rule {
    match app-id=r#"^wpsoffice"#
    open-maximized true
    background-effect {
        blur true
    }
    opacity 1.0
}

window-rule {
    match app-id="^wps$" title="^wps$"
    open-floating true
    open-focused false
    draw-border-with-background true
    background-effect {
        blur true
    }
    border {
        off
    }
    focus-ring {
        off
    }
    geometry-corner-radius 12
    clip-to-geometry true
}

window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
    background-effect {
        xray true
    }
}

layer-rule {
    match namespace="noctalia-window-switcher"
    background-effect {
        blur true
        xray true
    }
}

layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}

window-rule {
    match title=r#"^Picture-in-Picture$"#
    open-floating true
}

window-rule {
    match title=r#"Sign in - Google Accounts"#
    open-floating true
}

window-rule {
    match title=r#"^(Open|Save|Select Files|File Upload)$"#
    open-floating true
}

window-rule {
    match title="org-capture-pop"
    open-floating true
    open-focused true
}
